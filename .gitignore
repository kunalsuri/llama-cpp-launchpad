# Model files are large; never commit them
*.gguf
*.bin
# ...except the tiny metadata-only headers the tests read (tests/fixtures/make_gguf_fixtures.py)
!tests/fixtures/*.gguf

# Local llama.cpp builds or downloads
bin/
llama-server
llama-server.exe
llama-release/

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Logs and local Claude Code state
*.log
# .claude/: share settings.json and skills; keep personal settings and anything else local
.claude/*
!.claude/settings.json
!.claude/skills/
.webui_secret_key

# Personal setup profile written by model-setup (hardware, installed model, last check)
.launchpad-state
.launchpad-state.tmp.*
*.part
data/

# Python
__pycache__/
*.pyc

# Dev environment (scripts/win/dev-setup.ps1)
.venv/
.system.env
.hardware.env
.pytest_cache/
.coverage

# Developer tools for the real-browser test (package.json)
node_modules/
test-results/

# The model list llama-server router mode reads (written by the setup page: All my models)
.launchpad-models.ini
.launchpad-models.ini.tmp
